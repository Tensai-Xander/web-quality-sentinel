    "vue": "^3.5.45",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
